# 本地 Whisper 模型：tiny / base / small / medium / large-v3
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# 双语阅读段落对齐的本地多语言句向量模型
READING_EMBEDDING_MODEL=paraphrase-multilingual-mpnet-base-v2

# DeepSeek（文本润色、生词释义）— 留空则跳过这些步骤，只保留 Whisper 原始断句
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# Azure Speech（发音评估 + 标准美式/英式发音 TTS）— 留空则跳过评分与标准发音合成
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
